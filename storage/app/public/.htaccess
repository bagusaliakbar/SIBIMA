# Allow static files in public storage, but forbid PHP execution
<FilesMatch "\.(php|php\d*|phtml|phar|pl|py|cgi|sh|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

